{
  "expo": {
    "name": "Selodía",
    "slug": "mobile",
    "owner": "unflump",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Selodía uses your microphone to let you log food, activity and body data hands-free."
      }
    },
    "android": {
      "package": "com.unflump.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C97458",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D2B28",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selodía uses your photos so you can log a meal or a scale reading by picture instead of typing it.",
          "cameraPermission": "Selodía uses your camera so you can log a meal or a scale reading by photo instead of typing it."
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Selodía reads your step count and activity data to give you a more complete picture of your daily movement."
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C97458"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraMavenRepos": [
              "https://maven-central.storage-download.googleapis.com/maven2/"
            ]
          }
        }
      ],
      "expo-image",
      "@livekit/react-native-expo-plugin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd63f8e6-8d2c-45e0-ab5a-649709d1cb89"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cd63f8e6-8d2c-45e0-ab5a-649709d1cb89"
    }
  }
}
