{
  "expo": {
    "name": "Selodía",
    "slug": "mobile",
    "owner": "selodia",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "selodia",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.selodia",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Selodía uses your microphone to let you log food, activity and body data hands-free."
      }
    },
    "android": {
      "package": "app.selodia",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#C97458",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_BONE_MASS",
        "android.permission.health.READ_BODY_WATER_MASS",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D2B28",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Selodía uses your microphone so you can record a voice note or talk to Selodía instead of typing."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selodía uses your photos so you can log a meal or a scale reading by picture instead of typing it.",
          "cameraPermission": "Selodía uses your camera so you can log a meal or a scale reading by photo instead of typing it."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Selodía reads the health data you choose to share - steps, sleep, weight and body composition, workouts, water and cycle dates - so your record is complete without typing it all in twice.",
          "NSHealthUpdateUsageDescription": "Selodía does not add anything to your Health data. It only ever reads.",
          "background": true
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-rationale",
      "./plugins/with-product-name",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C97458"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraMavenRepos": [
              "https://maven-central.storage-download.googleapis.com/maven2/"
            ]
          }
        }
      ],
      "expo-image",
      "@livekit/react-native-expo-plugin",
      "expo-video",
      [
        "expo-calendar",
        {
          "calendarPermission": "Selodía asks so it can put a session or an appointment into the calendar you already use, instead of keeping it somewhere you would have to remember to check."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd63f8e6-8d2c-45e0-ab5a-649709d1cb89"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cd63f8e6-8d2c-45e0-ab5a-649709d1cb89",
      "fallbackToCacheTimeout": 12000,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
